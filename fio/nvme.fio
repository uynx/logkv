[global]
ioengine=psync
direct=1
size=512m
runtime=15
time_based
group_reporting

[randread-4k-qd1]
rw=randread
bs=4k
stonewall

[randread-4k-8jobs]
rw=randread
bs=4k
numjobs=8
stonewall

[randwrite-4k-fdatasync]
rw=randwrite
bs=4k
fdatasync=1
stonewall

[seqwrite-1m]
rw=write
bs=1m
stonewall

[seqread-1m]
rw=read
bs=1m
stonewall
